<Window x:Class="AseIsql.Desktop.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" TextOptions.TextFormattingMode="Display" Title="DBMON SQL Logon" Width="620" Height="660" MinWidth="560" MinHeight="580" WindowStartupLocation="CenterOwner" Closing="OnClosing">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="Feedback" Text="Choose a server from sql.ini or a saved profile." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="TestButton" Content="Test connection" Click="TestClick"/><Button x:Name="ConnectButton" Content="Connect" Click="ConnectClick" IsDefault="True" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"/><Button x:Name="CloseButton" Content="Cancel" Click="CloseClick" IsCancel="True"/></StackPanel>
    </StackPanel>
    <TabControl x:Name="Fields" Style="{StaticResource SegmentedTabs}">
      <TabItem ><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE703;"/><TextBlock Text="Connection" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <Grid>
          <Grid.Resources><Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,8"/></Style></Grid.Resources>
          <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Profile:"/><ComboBox x:Name="SavedProfiles" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="SavedProfileChosen" ToolTip="Logins saved in DBMON SQL. Manage them in the Profiles tab."/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Server type:" Grid.Row="1"/><ComboBox x:Name="PlatformSelector" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="PlatformChanged" ToolTip="SAP ASE and Replication Server use the SAP ASE ODBC driver; SAP IQ uses the SAP IQ ODBC driver. Choose the type: it is never guessed from the alias."/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Login:" Grid.Row="2"/><TextBox x:Name="UserName" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Password:" Grid.Row="3"/><PasswordBox x:Name="Password" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
          <TextBlock x:Name="DatabaseLabel" Style="{StaticResource FieldLabel}" Text="Database:" Grid.Row="4"/><TextBox x:Name="Database" Text="master" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Server:" Grid.Row="5"/><ComboBox x:Name="ServerAliases" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="ServerChanged"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Charset:" Grid.Row="6"/><ComboBox x:Name="Charset" IsEditable="True" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" ToolTip="ServerDefault: use the server charset; utf8: request UTF-8"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Hostname:" Grid.Row="7"/><ComboBox x:Name="Hostname" IsEditable="True" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"/>
        </Grid>
        <DockPanel x:Name="LanguageRow" Margin="0,0,0,8"><TextBlock Text="Language:" Width="90" VerticalAlignment="Center"/><ComboBox x:Name="LoginLanguage" IsEditable="True" ToolTip="ASE message language; us_english avoids inheriting the Windows regional language"/></DockPanel>
        <WrapPanel><CheckBox x:Name="EncryptPassword" Content="Encrypt password" IsChecked="True"/><CheckBox x:Name="EncryptData" Content="Encrypt data (TLS)" IsChecked="False" ToolTip="The default follows the ssl option in sql.ini. Without TLS, queries and results are not encrypted in transit."/><CheckBox x:Name="RememberPassword" Content="Remember password" IsChecked="False" ToolTip="Stores the password with the profile, encrypted for your Windows user. Saved when you save the profile or connect with it."/></WrapPanel>
        <TextBlock x:Name="EndpointSummary" Text="No server selected" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,8"/>
        <ComboBox x:Name="Endpoints" Visibility="Collapsed" SelectionChanged="EndpointChanged" Margin="0,0,0,8"/>
        <TextBlock Text="sql.ini file" Foreground="{DynamicResource Muted}" Margin="0,8,0,5"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseIni"/><Button DockPanel.Dock="Right" Content="Reload" Click="ReloadIni"/><TextBox x:Name="IniPath" IsReadOnly="True" ToolTip="Reads the Sybase file without modifying it"/></DockPanel>
        <Expander x:Name="AdvancedOptions" Header="Advanced options" Margin="0,14,0,0" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,10,0,0">
          <CheckBox x:Name="ManualMode" Content="Enter host and port manually" Checked="ManualChanged" Unchecked="ManualChanged"/>
          <Grid x:Name="ManualFields" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="Server" ToolTip="Host / IP"/><TextBox x:Name="Port" Grid.Column="1" Text="5000" Margin="8,0,0,0"/></Grid>
          <StackPanel x:Name="IqServerRow" Visibility="Collapsed"><TextBlock Text="IQ server name (optional)" Margin="0,10,0,5"/><TextBox x:Name="IqServerName" ToolTip="The IQ engine name. Leave empty when a single IQ server listens on this host and port."/></StackPanel>
          <TextBlock Text="TrustedFile · CA certificates (required for TLS)" Margin="0,10,0,5"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="Browse CA…" Click="BrowseTrustedFile"/><TextBox x:Name="TrustedFile" ToolTip="Server CA file in a format supported by SAP ODBC"/></DockPanel>
          <StackPanel x:Name="IqIdentityRow" Visibility="Collapsed">
            <TextBlock Text="Client identity file (.id, when required by SAP IQ)" Margin="0,12,0,4"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Browse identity…" Click="BrowseIdentityFile"/><TextBox x:Name="IqIdentityFile" TextChanged="IdentityFileChanged" ToolTip="The client certificate and private key. Use together with the trusted certificate above and enable TLS."/></DockPanel>
            <TextBlock Text="Client identity password" Margin="0,8,0,4"/>
            <PasswordBox x:Name="IqIdentityPassword" ToolTip="Password for the private key in the .id file. Separate from the database login password; never saved."/>
            <TextBlock Text="The profile saves both file paths. The identity password is never saved; enter it for each connection." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="Login timeout (s)"/><TextBox x:Name="LoginTimeout" Text="15"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Query timeout (s)"/><TextBox x:Name="QueryTimeout" Text="60"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Maximum rows"/><TextBox x:Name="MaxRows" Text="10000"/></StackPanel>
          </Grid>
        </StackPanel></Expander>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="ProfilesTab" ><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE77B;"/><TextBlock Text="Profiles" VerticalAlignment="Center"/></StackPanel></TabItem.Header><DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="Saved profiles" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold"/><TextBlock Text="Profiles keep connection settings, server alias and sql.ini path inside DBMON SQL, encrypted for your Windows user. A password is kept only when Remember password is on." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,14"/>
          <DockPanel Margin="0,0,0,10"><Button x:Name="SaveProfileButton" DockPanel.Dock="Right" Content="Save current" Click="SaveProfile"/><TextBox x:Name="ProfileName" ToolTip="Profile name. An existing name is updated."/></DockPanel></StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock x:Name="ProfilesPath" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0"><Button x:Name="LoadProfileButton" Content="Load" Click="LoadProfileClick" Margin="0,0,0,6"/><Button x:Name="ForgetPasswordButton" Content="Forget password" Click="ForgetPasswordClick" Margin="0,0,0,6"/><Button x:Name="DeleteProfileButton" Content="Delete" Click="DeleteProfileClick"/></StackPanel>
        <ListBox x:Name="ProfileList" MouseDoubleClick="LoadProfileClick" SelectionChanged="ProfileListChanged"/>
      </DockPanel></TabItem>
      <TabItem ><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabIcon}" Text="&#xE946;"/><TextBlock Text="Information" VerticalAlignment="Center"/></StackPanel></TabItem.Header><StackPanel Margin="16"><TextBlock x:Name="DriverStatus" Text="Driver: SAP Adaptive Server Enterprise · 64 bits" TextWrapping="Wrap"/><TextBlock x:Name="CatalogInformation" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/><TextBlock Text="Uses query entries from the file. Master entries belong to the listener. Choose a server before connecting." TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
