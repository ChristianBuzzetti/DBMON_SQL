<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><AssemblyName>DBMON SQL</AssemblyName><ApplicationIcon>Assets\dbmon-sql.ico</ApplicationIcon><Product>DBMON SQL</Product><ApplicationManifest>app.manifest</ApplicationManifest></PropertyGroup>
  <PropertyGroup Condition="'$(Smoke)' == 'true'">
    <DefineConstants>$(DefineConstants);DBMON_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Smoke)' != 'true'">
    <Compile Remove="MainWindow.*Smoke.cs;MainWindow.Showcase.cs" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" /><ProjectReference Include="../AseIsql.Core/AseIsql.Core.csproj" /><ProjectReference Include="../AseIsql.Odbc/AseIsql.Odbc.csproj" /><PackageReference Include="AvalonEdit" Version="6.3.1.120" /></ItemGroup>
  <ItemGroup><Content Include="Assets/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><Resource Include="Assets/Fonts/*.ttf" /><Resource Include="Assets/boberto.png" /><Resource Include="Assets/dbmon-sql.ico" /><Resource Include="Assets/dbmon-sql.png" /><Resource Include="Assets/dbmon-mark.png" /><Content Include="Assets/Fonts/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup><ItemGroup><Content Include="Assets/Boberto/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="Assets/Fonts/Inter-Regular.ttf" TargetPath="Assets/Boberto/fonts/Inter-Regular.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup></Project>
