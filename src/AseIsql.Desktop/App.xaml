<Application x:Class="AseIsql.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AseIsql.Desktop" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Visual language of DBMON (SMG_APPS shared/css/tokens.css + skin-neomirai.css): token surfaces, hairline borders
         in the text color, accent rings with a soft glow, mono data and uppercase section labels. Square by default
         (Neo Mirai); "Soft control corners" switches the radius resources to DBMON's standard r-sm/r-md. -->
    <local:UpperCaseConverter x:Key="UpperCase"/>
    <!-- Narrow windows drop the top-level menu glyphs (MainWindow overrides this) so the menu strip stays on one row. -->
    <Visibility x:Key="TopMenuGlyph">Visible</Visibility>
    <Style x:Key="UiControl" TargetType="Control"><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style TargetType="Label" BasedOn="{StaticResource UiControl}"/>
    <Style TargetType="Expander" BasedOn="{StaticResource UiControl}"/>
    <!-- List rows: DBMON's 3 px left accent marks the selected row; hover lifts to bg-hover. -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource UiControl}"><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AlternateRow}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeak}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Window" BasedOn="{StaticResource UiControl}"><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource CanvasGrid}"/><Setter Property="Icon" Value="pack://application:,,,/Assets/dbmon-sql.ico"/></Style>

    <!-- Uppercase section label (.dbm-side-label): small, bold, muted. Text is written uppercase by the caller. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="GlyphText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

    <!-- .btn: bg-elev-2, 1 px hairline, 32 px; hover lifts to bg-hover with a stronger hairline, focus takes the accent ring. -->
    <Style TargetType="Button" BasedOn="{StaticResource UiControl}">
      <Setter Property="Padding" Value="12,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="8,2"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/></Style>
    <!-- Topbar actions (#btnTweaks, search): transparent box with a hairline, muted ink; hover brightens. -->
    <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource UiControl}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AlternateRow}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StrongBorder}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <!-- .chip: bg-elev-1, hairline, mono 11.5 px, muted; the session chip of the subbar. -->
    <Style x:Key="SessionChip" TargetType="Button" BasedOn="{StaticResource UiControl}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/><Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/><Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PillRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <!-- Colophon segment: flat mono text that reads as status until hover reveals it as an action. -->
    <Style x:Key="StatusSegment" TargetType="Button" BasedOn="{StaticResource UiControl}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/><Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/><Setter Property="Padding" Value="6,1"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentTint}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentCardRing}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <!-- .icon-btn: 32 px square, transparent until hover. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource UiControl}"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AlternateRow}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Selectable cards (palette tiles, font options, accent swatches): content stretches, hover and focus draw the accent ring. -->
    <Style x:Key="OptionCard" TargetType="Button" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AlternateRow}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <!-- Sliders: 4 px rail, accent fill up to the value, a ringed accent knob. -->
    <Style x:Key="SliderRail" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SliderKnob" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Surface}" BorderThickness="3"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource AccentWeak}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider" BasedOn="{StaticResource UiControl}"><Setter Property="Cursor" Value="Hand"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Border x:Name="Focus" BorderThickness="0,0,0,1" BorderBrush="Transparent" Background="Transparent"><Track x:Name="PART_Track" Height="22">
        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderRail}" Background="{DynamicResource Accent}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRail}" Background="{DynamicResource StrongBorder}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource SliderKnob}"/></Track.Thumb></Track></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Inputs: bg-elev-1, hairline, 34 px; focus draws the accent ring. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"><ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="PasswordChar" Value="&#x2022;"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"><ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" Focusable="False"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/><Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StrongBorder}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter x:Name="SelectionContent" IsHitTestVisible="False" Margin="10,6,28,6" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="2,2,26,2" BorderThickness="0" Background="{DynamicResource Surface}" Padding="8,4" Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource AccentRule}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3" Margin="0,2,0,0"><ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeak}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Menu bar as a .seg strip; the open menu takes the active ring. Popups are modal cards with an accent edge. -->
    <Style TargetType="Menu" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Menu"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><Border HorizontalAlignment="Left" Padding="2" CornerRadius="{DynamicResource StripRadius}" BorderThickness="1" BorderBrush="{DynamicResource FaintBorder}" Background="{DynamicResource Surface}"><ItemsPresenter/></Border></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentRule}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlRadius}" Margin="0,0,10,12"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45"/></Border.Effect><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource UiControl}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Grid><Border x:Name="ItemFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}"><Grid>
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="Gutter" Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="ArrowColumn" Width="16"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="CheckMark" Text="✓" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="TopGlyph" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/></StackPanel>
          <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" VerticalAlignment="Center" Margin="24,0,0,0"/>
          <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" HorizontalAlignment="Right" Visibility="Collapsed"/>
        </Grid></Border>
        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
          <Border x:Name="SubmenuSurface" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource AccentRule}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="4" MinWidth="230" Margin="0,0,10,12"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45"/></Border.Effect><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
        </Popup></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource AccentWeak}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="ItemFrame" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Role" Value="TopLevelHeader"/><Condition Property="IsHighlighted" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter TargetName="ItemFrame" Property="BorderBrush" Value="{DynamicResource FaintBorder}"/></MultiTrigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="Role" Value="TopLevelHeader"/><Condition Property="IsSubmenuOpen" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter TargetName="ItemFrame" Property="BorderBrush" Value="{DynamicResource AccentRing}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="TopGlyph" Property="Foreground" Value="{DynamicResource Accent}"/></MultiTrigger>
          <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="TopGlyph" Property="Visibility" Value="{DynamicResource TopMenuGlyph}"/><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter TargetName="ItemFrame" Property="MinHeight" Value="28"/><Setter Property="FontWeight" Value="Medium"/><Setter TargetName="Gutter" Property="Width" Value="0"/><Setter TargetName="ArrowColumn" Property="Width" Value="0"/><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/><Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/><Setter Property="Padding" Value="12,3"/><Setter TargetName="PART_Popup" Property="VerticalOffset" Value="4"/></Trigger>
          <Trigger Property="Role" Value="TopLevelItem"><Setter TargetName="Gutter" Property="Width" Value="0"/><Setter TargetName="ArrowColumn" Property="Width" Value="0"/><Setter Property="Padding" Value="7,4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,4" Background="{DynamicResource FaintBorder}"/></ControlTemplate></Setter.Value></Setter></Style>
    <!-- Checkboxes are DBMON toggles (.live-toggle): a track with a knob that slides right and takes the accent when on. -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource UiControl}"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,6,16,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent">
        <Grid Width="36" Height="20" VerticalAlignment="Center"><Border x:Name="Track" CornerRadius="{DynamicResource PillRadius}" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource StrongBorder}" BorderThickness="1"/><Border x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="{DynamicResource PillRadius}" Background="{DynamicResource Muted}"/></Grid>
        <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentRing}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentWeak}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentRing}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Center"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource FaintBorder}"/></Style>
    <Style TargetType="TreeView" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource UiControl}"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="3,2"/>
      <Style.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/></Style.Resources>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style>

    <!-- .proc-table: uppercase mono headers on an accent rule; rows divided by an accent-tinted hairline. -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource UiControl}">
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AccentRowRule}"/>
      <Setter Property="RowHeight" Value="{DynamicResource GridRowHeight}"/><Setter Property="ColumnHeaderHeight" Value="{DynamicResource GridHeaderHeight}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateRow}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="SelectionUnit" Value="CellOrRowHeader"/><Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/><Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UpperCase}}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Grid><Border x:Name="Head" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource AccentRule}" BorderThickness="0,0,0,1.5" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource FaintBorder}"/><Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="SortDirection" Value="Ascending"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="SortDirection" Value="Descending"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border x:Name="Cell" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Tabs as Boberto Studio's segmented navigation (.bes-nav-apartados): one framed strip with a 3 px inset and a
         2 px gap; idle segments are dim ink, hover lifts them, and the selected one is a raised plate with a hairline
         ring, full ink and the accent on its icon. The workspace keeps content-sized tabs for its results; fixed
         section sets use SegmentedTabs, whose segments share the strip width. -->
    <Style TargetType="TabControl" BasedOn="{StaticResource UiControl}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Rule}"/><Setter Property="Padding" Value="12,12,12,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local">
        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}" Padding="3" CornerRadius="{DynamicResource StripRadius}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{DynamicResource Header}"><TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/></Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,8,0,0"/>
      </DockPanel></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SegmentedTabs" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local">
        <Border DockPanel.Dock="Top" Margin="{TemplateBinding Padding}" Padding="3" CornerRadius="{DynamicResource StripRadius}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{DynamicResource Header}"><UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/></Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,10,0,0"/>
      </DockPanel></ControlTemplate></Setter.Value></Setter></Style>
    <!-- No dotted focus rectangle: it covered the frame's right edge after a rename; the Frame draws keyboard focus in the accent. -->
    <Style TargetType="TabItem" BasedOn="{StaticResource UiControl}"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="14,0"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Frame" MinHeight="32" CornerRadius="{DynamicResource ControlRadius}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.FontWeight="Medium" TextElement.Foreground="{DynamicResource LineNumber}"/></Border>
        <ControlTemplate.Triggers>
          <!-- Header ink only: the selected tab's content keeps its own foreground. -->
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AlternateRow}"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource Muted}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Rule}"/><Setter TargetName="Frame" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.22"/></Setter.Value></Setter><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="TabIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Opacity" Value="0.75"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style>

    <!-- Neo Mirai card (.motor): accent rings and a deep shadow on its own layer (content is never rendered through an
         effect). The corner brackets were removed at the user's request. -->
    <Style x:Key="NeoCard" TargetType="ContentControl"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid>
      <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource StripRadius}"><Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45"/></Border.Effect></Border>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource AccentCardOuter}" BorderThickness="1" CornerRadius="{DynamicResource StripRadius}"><Border BorderBrush="{DynamicResource AccentCardRing}" BorderThickness="1" CornerRadius="{DynamicResource StripRadius}"><ContentPresenter/></Border></Border>
    </Grid></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Scrollbars (::-webkit-scrollbar): 10 px, transparent track, border-strong thumb, text-dim on hover. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" CornerRadius="3" Background="{DynamicResource StrongBorder}"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource LineNumber}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" Padding="2"><Track x:Name="PART_Track" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
  </Application.Resources>
</Application>
