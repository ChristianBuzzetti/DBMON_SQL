<Project><PropertyGroup>
  <Version>0.1.0</Version>
  <Authors>Christian Buzzetti</Authors><Company>Christian Buzzetti</Company>
  <Copyright>Copyright (c) 2026 Christian Buzzetti. MIT License.</Copyright>
  <Description>DBMON SQL: a Windows SQL workbench for SAP ASE, SAP IQ and SAP Replication Server.</Description>
  <RepositoryUrl>https://github.com/ChristianBuzzetti/DBMON_SQL</RepositoryUrl>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  <TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic>
  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
</PropertyGroup></Project>
